---
import type { Training } from "../lib/content";
import { formatRupiah } from "../lib/content";
import Icon from "./Icon.astro";

interface Props {
  training: Training;
  class?: string;
}

const { training, class: className = "" } = Astro.props;

const tones: Record<string, string> = {
  mint: "bg-[#EDF5FD] text-forest-800",
  forest: "bg-[#E2ECF7] text-forest-800",
  peach: "bg-[#F5F4FF] text-[#4F47A3]",
  sand: "bg-[#F1FAF9] text-[#0F766E]",
  stone: "bg-[#F3F6FA] text-[#516479]",
};

const finalPrice = Math.round(training.price * (1 - training.subsidy));
---

<article class:list={["reveal card flex h-full flex-col p-6", className]}>
  <div class="flex items-start justify-between gap-3">
    <span class:list={["badge", tones[training.tone] ?? tones.forest]}>{training.cat}</span>
    {training.certified && (
      <span class="inline-flex items-center gap-1 text-[0.62rem] font-bold uppercase tracking-[0.1em] text-forest-700">
        <Icon name="ph:seal-check" size={14} class="text-honey-500" />
        Sertifikasi
      </span>
    )}
  </div>

  <h3 class="mt-5 font-display text-[1.2rem] font-semibold leading-tight text-ink">{training.title}</h3>
  <p class="mt-2 text-sm leading-7 text-muted">{training.desc}</p>

  <dl class="mt-5 grid gap-2.5 text-xs">
    <div class="flex items-center gap-2 text-muted">
      <Icon name="ph:calendar-dots" size={15} class="shrink-0 text-forest-600" />
      <dt class="sr-only">Jadwal</dt>
      <dd>Mulai {training.start} · ilustrasi</dd>
    </div>
    <div class="flex items-center gap-2 text-muted">
      <Icon name="ph:clock" size={15} class="shrink-0 text-forest-600" />
      <dt class="sr-only">Durasi</dt>
      <dd>{training.duration} · {training.mode}</dd>
    </div>
    <div class="flex items-center gap-2 text-muted">
      <Icon name="ph:users-three" size={15} class="shrink-0 text-forest-600" />
      <dt class="sr-only">Penyelenggara</dt>
      <dd>{training.provider}</dd>
    </div>
  </dl>

  <div class="mt-auto flex items-end justify-between gap-3 border-t border-line pt-5">
    <div>
      <p class="text-[0.64rem] font-semibold uppercase tracking-[0.1em] text-muted-soft">Biaya ilustrasi</p>
      <p class="mt-1 font-display text-[1.1rem] font-semibold text-ink">
        {formatRupiah(finalPrice)}
        {training.subsidy > 0 && (
          <span class="ml-1 align-middle text-[0.65rem] font-medium text-muted-soft line-through">
            {formatRupiah(training.price)}
          </span>
        )}
      </p>
    </div>
    <a
      href="/tentang#pengembangan"
      data-login-open
      class="inline-flex items-center gap-1.5 rounded-full bg-forest-50 px-3.5 py-2 text-xs font-semibold text-forest-800 transition hover:bg-forest-100"
    >
      Daftar minat
      <Icon name="ph:arrow-up-right" size={13} />
    </a>
  </div>
</article>
