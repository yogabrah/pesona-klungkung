---
import Icon from "./Icon.astro";

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: readonly FaqItem[];
  schema?: boolean;
  class?: string;
}

const { items, schema = true, class: className = "" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<div class:list={["reveal divide-y divide-line overflow-hidden rounded-[1.5rem] border border-line bg-white/80", className]}>
  {
    items.map((item) => (
      <details class="group px-5 py-1 sm:px-6">
        <summary class="flex cursor-pointer items-start justify-between gap-5 py-5 text-left">
          <span class="font-display text-[1.03rem] font-semibold leading-snug text-ink sm:text-[1.1rem]">
            {item.q}
          </span>
          <span class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-forest-800 transition duration-300 group-open:rotate-45 group-open:border-forest-300 group-open:bg-forest-50">
            <Icon name="ph:plus" size={15} />
          </span>
        </summary>
        <div class="pb-6 pr-12 text-sm leading-7 text-muted">{item.a}</div>
      </details>
    ))
  }
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
