---
import { articleIconByCategory, articleTone } from "../lib/content";
import Icon from "./Icon.astro";

interface Props {
  category: string;
  large?: boolean;
  class?: string;
}

const { category, large = false, class: className = "" } = Astro.props;
const toneKey = articleTone[category] ? category : "Panduan";

const tones: Record<string, { surface: string; icon: string; accent: string; label: string }> = {
  PBJT: { surface: "bg-forest-50", icon: "text-forest-800", accent: "bg-honey-300", label: "bg-white text-forest-800" },
  Administrasi: { surface: "bg-[#F5F4FF]", icon: "text-clay-700", accent: "bg-clay-200", label: "bg-white text-clay-700" },
  "PBB-P2": { surface: "bg-[#EDF5FD]", icon: "text-forest-800", accent: "bg-forest-300", label: "bg-white text-forest-800" },
  Panduan: { surface: "bg-sand-50", icon: "text-honey-800", accent: "bg-honey-300", label: "bg-white text-honey-800" },
  Reklame: { surface: "bg-[#F1FAF9]", icon: "text-[#0F766E]", accent: "bg-[#DDF3F0]", label: "bg-white text-[#0F766E]" },
  BPHTB: { surface: "bg-[#F5F4FF]", icon: "text-clay-700", accent: "bg-clay-200", label: "bg-white text-clay-700" },
  Pembayaran: { surface: "bg-forest-50", icon: "text-forest-800", accent: "bg-forest-300", label: "bg-white text-forest-800" },
  Kepatuhan: { surface: "bg-[#F3F6FA]", icon: "text-[#516479]", accent: "bg-[#C3BFF4]", label: "bg-white text-[#516479]" },
  PAT: { surface: "bg-[#F1FAF9]", icon: "text-[#0F766E]", accent: "bg-[#DDF3F0]", label: "bg-white text-[#0F766E]" },
};

const tone = tones[toneKey] ?? tones.Panduan;
---

<div
  class:list={[
    "relative overflow-hidden rounded-[1.35rem] border border-line/70",
    tone.surface,
    large ? "min-h-[16rem] p-7 sm:min-h-[20rem] sm:p-9" : "min-h-[10.5rem] p-5",
    className,
  ]}
>
  <div class="absolute inset-0 opacity-[0.22] dot-grid" aria-hidden="true"></div>
  <svg class="absolute -right-8 -top-8 text-forest-900/10" width="220" height="220" viewBox="0 0 220 220" fill="none" aria-hidden="true">
    <circle cx="110" cy="110" r="82" stroke="currentColor" stroke-width="1.2"></circle>
    <circle cx="110" cy="110" r="54" stroke="currentColor" stroke-width="1.2"></circle>
    <path d="M28 150c42-48 121-83 180-53" stroke="currentColor" stroke-width="1.2"></path>
  </svg>

  <div class="relative flex h-full flex-col justify-between gap-8">
    <div class="flex items-center justify-between gap-3">
      <span class:list={["inline-flex rounded-full px-3 py-1 text-[0.64rem] font-bold uppercase tracking-[0.13em]", tone.label]}>
        {category}
      </span>
      <span class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-forest-900/40">
        Citta Vidya
      </span>
    </div>

    <div class="flex items-end justify-between gap-4">
      <div class:list={["inline-flex items-center justify-center rounded-[1.1rem] bg-white/70 shadow-sm", tone.icon, large ? "size-20" : "size-14"]}>
        <Icon name={articleIconByCategory[category] ?? "ph:book-open-text"} size={large ? 40 : 27} />
      </div>
      <div class="flex items-end gap-1.5" aria-hidden="true">
        <span class:list={["rounded-full", tone.accent, large ? "h-20 w-2.5" : "h-11 w-1.5"]}></span>
        <span class:list={["rounded-full bg-forest-900/15", large ? "h-12 w-2.5" : "h-6 w-1.5"]}></span>
        <span class:list={["rounded-full bg-forest-900/30", large ? "h-16 w-2.5" : "h-8 w-1.5"]}></span>
      </div>
    </div>
  </div>
</div>
