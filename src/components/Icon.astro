---
import { Icon as AstroIcon } from "astro-icon/components";

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  "aria-hidden"?: boolean | "true" | "false";
  "aria-label"?: string;
}

const { name, size = 20, class: className = "", ...rest } = Astro.props;
---

<AstroIcon
  name={name}
  size={size}
  class={className}
  aria-hidden={rest["aria-label"] ? undefined : "true"}
  {...rest}
/>
