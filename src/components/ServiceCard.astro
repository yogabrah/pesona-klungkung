---
import type { Service, ServiceTone } from "../data/services";
import Icon from "./Icon.astro";

interface Props {
  service: Service;
  index?: number;
  class?: string;
}

const { service, index, class: className = "" } = Astro.props;

const tones: Record<ServiceTone, { icon: string; badge: string; border: string }> = {
  forest: {
    icon: "bg-forest-100 text-forest-800",
    badge: "bg-forest-50 text-forest-700",
    border: "hover:border-forest-300",
  },
  sand: {
    icon: "bg-sand-100 text-honey-800",
    badge: "bg-sand-50 text-honey-800",
    border: "hover:border-sand-300",
  },
  mint: {
    icon: "bg-[#DDF3F0] text-[#0F766E]",
    badge: "bg-[#F0FAF8] text-[#0F766E]",
    border: "hover:border-[#A9DED7]",
  },
  peach: {
    icon: "bg-clay-100 text-clay-700",
    badge: "bg-[#F5F4FF] text-clay-700",
    border: "hover:border-clay-200",
  },
};

const tone = tones[service.tone];
---

<a
  href={`/layanan/${service.slug}`}
  class:list={["reveal group card card-hover relative flex h-full flex-col overflow-hidden p-6 sm:p-7", tone.border, className]}
>
  <div class="flex items-start justify-between gap-4">
    <span class:list={["inline-flex size-12 items-center justify-center rounded-2xl transition duration-500 group-hover:scale-105", tone.icon]}>
      <Icon name={service.icon} size={24} />
    </span>
    <div class="flex items-center gap-2">
      {index && <span class="font-display text-xs font-semibold tabular-nums text-muted-soft">0{index}</span>}
      <span class:list={["badge", tone.badge]}>{service.tag}</span>
    </div>
  </div>

  <h3 class="mt-6 font-display text-[1.35rem] font-semibold leading-tight text-ink">
    {service.title}
  </h3>
  <p class="mt-3 flex-1 text-sm leading-7 text-muted">{service.description}</p>

  <div class="mt-6 flex items-center justify-between border-t border-line pt-4">
    <span class="text-[0.7rem] font-medium text-muted-soft">{service.meta}</span>
    <span class="inline-flex size-8 items-center justify-center rounded-full bg-forest-50 text-forest-800 transition duration-300 group-hover:bg-forest-800 group-hover:text-white">
      <Icon name="ph:arrow-up-right" size={15} />
    </span>
  </div>
</a>
