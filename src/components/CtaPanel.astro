---
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel: string;
  primaryHref?: string;
  primaryLogin?: boolean;
  secondaryLabel?: string;
  secondaryHref?: string;
  note?: string;
}

const {
  eyebrow = "Langkah berikutnya",
  title,
  description,
  primaryLabel,
  primaryHref = "/layanan",
  primaryLogin = false,
  secondaryLabel,
  secondaryHref,
  note,
} = Astro.props;
---

<section class="container-page pb-20 pt-4 sm:pb-24">
  <div class="reveal surface-dark relative overflow-hidden rounded-[2rem] px-6 py-12 text-white sm:px-10 sm:py-14 lg:px-16 lg:py-16">
    <div class="pointer-events-none absolute inset-0 opacity-20 dot-grid-light" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full bg-forest-500/25 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/3 size-80 rounded-full bg-honey-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      <div class="max-w-2xl">
        <p class="eyebrow-light">
          <span class="h-px w-7 bg-honey-300" aria-hidden="true"></span>
          {eyebrow}
        </p>
        <h2 class="display-md mt-4 text-white">{title}</h2>
        <p class="lead-light mt-4">{description}</p>
        {note && <p class="mt-5 text-xs leading-6 text-forest-100/65">{note}</p>}
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a
          href={primaryLogin ? "/tentang#pengembangan" : primaryHref}
          {...(primaryLogin ? { "data-login-open": true } : {})}
          class="btn btn-accent btn-lg whitespace-nowrap"
        >
          {primaryLabel}
          <Icon name={primaryLogin ? "ph:lock-key" : "ph:arrow-right"} size={18} />
        </a>
        {
          secondaryLabel && secondaryHref && (
            <a href={secondaryHref} class="btn btn-ghost-light btn-lg whitespace-nowrap">
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
