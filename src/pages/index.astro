          <a href="/usaha/registry" class="btn btn-secondary">Lihat registry</a>
        </div>
      </div>

      <div class="reveal relative">
        <div class="absolute -inset-3 rounded-[2.2rem] bg-honey-200/30 blur-2xl" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[1.75rem] border border-line bg-white/90 shadow-lift">
          <div class="flex items-center justify-between gap-3 border-b border-line bg-paper/85 px-5 py-4">
            <div class="flex items-center gap-2.5">
              <span class="flex gap-1.5" aria-hidden="true">
                <span class="size-2 rounded-full bg-[#B7C8E4]"></span>
                <span class="size-2 rounded-full bg-[#C7D8EB]"></span>
                <span class="size-2 rounded-full bg-[#9DB9D6]"></span>
              </span>
              <p class="text-xs font-semibold text-ink">Registry penyedia</p>
            </div>
            <span class="badge bg-sand-100 text-honey-800">Data ilustrasi</span>
          </div>

          <div class="p-3 sm:p-4">
            <div class="space-y-2.5">
              {
                featuredProviders.map((provider) => (
                  <div class="flex items-center gap-3 rounded-xl border border-line bg-paper/60 p-3">
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-forest-50 text-forest-700">
                      <Icon name={providerIcons[provider.category] ?? "ph:storefront"} size={19} />
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-[0.8rem] font-semibold text-ink">{provider.name}</p>
                      <p class="mt-0.5 text-[0.65rem] text-muted">{provider.categoryLabel} · {provider.area}</p>
                    </div>
                    <span class="hidden items-center gap-1 rounded-full bg-forest-50 px-2.5 py-1 text-[0.58rem] font-bold uppercase tracking-[0.05em] text-forest-700 sm:inline-flex">
                      <Icon name="ph:seal-check" size={12} />
