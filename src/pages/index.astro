                    </span>
                    <Icon name="ph:caret-right" size={14} class="text-muted-soft" />
                  </div>
                ))
              }
            </div>

            <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
              <div class="rounded-xl bg-forest-50 p-3.5">
                <div class="flex items-center gap-2 text-forest-800">
                  <Icon name="ph:graduation-cap" size={17} />
                  <p class="text-[0.7rem] font-semibold">Pelatihan &amp; sertifikasi</p>
                </div>
                <p class="mt-1.5 text-[0.65rem] leading-5 text-muted">Contoh jadwal, kuota, dan pendampingan.</p>
              </div>
              <div class="rounded-xl bg-sand-100/60 p-3.5">
                <div class="flex items-center gap-2 text-honey-800">
                  <Icon name="ph:users-three" size={17} />
                  <p class="text-[0.7rem] font-semibold">Ruang koperasi</p>
                </div>
                <p class="mt-1.5 text-[0.65rem] leading-5 text-muted">Anggota, listing, dan bagi hasil.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------------ -->
  <!-- EDUKASI                                                            -->
