            <p class="mt-2 text-[0.65rem] leading-5 text-muted">penyedia contoh</p>
          </div>
          <div>
            <p class="font-display text-[1.8rem] font-semibold leading-none text-forest-800">{usahaStats.cooperatives}</p>
