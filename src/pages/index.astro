              <Icon name="ph:arrow-right" size={14} />
            </a>
          </div>
        </div>
        <FaqList items={HOME_FAQ} />
      </div>
    </div>
  </section>

  <CtaPanel
    eyebrow="Mulai dari satu langkah"
    title="Pahami dulu, urus kemudian, tumbuh bersama."
    description="Jelajahi layanan yang sedang dirancang atau lihat peta jalan pengembangan PESONA. Akun warga dan pelaku usaha akan dibuka secara bertahap."
    primaryLabel="Jelajahi layanan"
    primaryHref="/layanan"
    secondaryLabel="Lihat peta jalan"
    secondaryHref="/tentang#pengembangan"
    note="Situs konsep · bukan layanan resmi · seluruh data adalah ilustrasi."
  />
</BaseLayout>

