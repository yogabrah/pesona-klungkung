---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import FaqList from "../../components/FaqList.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import TaxCard from "../../components/TaxCard.astro";
import { taxList } from "../../lib/content";

const [firstTax, ...otherTaxes] = taxList;

const taxFaqs = [
  {
    q: "Apa beda pajak daerah dan pajak pusat?",
    a: "Pajak daerah dipungut pemerintah daerah, misalnya PBJT, PBB-P2, BPHTB, pajak reklame, dan pajak air tanah. Pajak pusat dikelola pemerintah pusat, seperti PPh dan PPN. Satu usaha dapat memiliki kewajiban pada keduanya.",
  },
  {
    q: "Apakah semua usaha memiliki objek pajak daerah?",
    a: "Tidak selalu. Kewajiban bergantung pada jenis kegiatan, lokasi, dan objek yang diatur dalam ketentuan daerah. Usaha kecil dengan objek tertentu mungkin belum termasuk. Kasus spesifik perlu dikonsultasikan melalui kanal resmi.",
  },
  {
    q: "Mengapa angka di situs ini bisa berbeda dengan tagihan?",
    a: "Angka di situs ini adalah ilustrasi. Tarif, dasar pengenaan, nilai objek, dan pengecualian resmi ditetapkan melalui Perda, peraturan pelaksanaan, SPPT, atau kode billing yang diterbitkan instansi berwenang.",
  },
  {
    q: "Apakah PESONA bisa menerbitkan ketetapan pajak?",
    a: "Tidak. PESONA adalah kanal edukasi dan pendampingan. Ketetapan pajak, izin, dan sertifikasi tetap menjadi kewenangan instansi berwenang.",
  },
];

const site = Astro.site ?? new URL("https://pesona.example");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Jenis Pajak Daerah Kabupaten Klungkung",
  description:
    "Penjelasan lima pajak daerah: PBJT, PBB-P2, BPHTB, pajak reklame, dan pajak air tanah.",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: taxList.map((tax, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${tax.name} — ${tax.long}`,
      url: new URL(`/pajak/${tax.slug}`, site).toString(),
    })),
  },
};
---

<BaseLayout
  title="Jenis Pajak Daerah"
  description="Kenali PBJT, PBB-P2, BPHTB, pajak reklame, dan pajak air tanah: objek, tarif, masa pajak, contoh perhitungan, dan dokumen yang perlu disiapkan."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Pajak daerah · Klungkung"
    title="Kenali pajak,"
    highlight="tanpa menebak."
    description="Lima jenis pajak yang paling dekat dengan warga, usaha, dan aktivitas sehari-hari di Klungkung. Setiap halaman menjelaskan objek, tarif, cara menghitung, dan batasannya."
    breadcrumbs={[{ label: "Beranda", href: "/" }, { label: "Pajak" }]}
    icon="ph:bank"
  >
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href="/kalkulator" class="btn btn-primary">
        Hitung simulasi
        <Icon name="ph:calculator" size={17} />
      </a>
      <a href="/edukasi" class="btn btn-secondary">
        Baca dasar pajak
        <Icon name="ph:book-open-text" size={17} />
      </a>
    </div>

    <div slot="aside" class="card overflow-hidden bg-white/85">
      <div class="flex items-center justify-between gap-3 border-b border-line bg-forest-50/70 px-5 py-4">
        <div>
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.14em] text-forest-700">Lima jenis</p>
          <p class="mt-1 font-display text-lg font-semibold text-ink">Pajak daerah</p>
        </div>
        <Icon name="ph:list-magnifying-glass" size={22} class="text-forest-700" />
      </div>
      <div class="divide-y divide-line">
        {
          taxList.map((tax) => (
            <a
              href={`/pajak/${tax.slug}`}
              class="flex items-center justify-between gap-3 px-5 py-3 text-xs font-medium text-muted transition hover:bg-forest-50/70 hover:text-forest-800"
            >
              <span>{tax.name}</span>
              <span class="text-[0.65rem] font-semibold tabular-nums text-forest-700">{tax.rate}</span>
            </a>
          ))
        }
      </div>
      <p class="border-t border-line px-5 py-3 text-[0.62rem] leading-5 text-muted-soft">
        Tarif dan ketentuan resmi mengikuti Perda dan peraturan yang berlaku.
      </p>
    </div>
  </PageHero>

  <!-- Daftar pajak -->
  <section class="section-pad">
    <div class="container-page">
      <SectionHead
        eyebrow="Mulai dari yang terdekat"
        title="Lima pajak, lima sudut pandang."
        description="Pilih jenis yang relevan dengan kegiatan Anda. Tidak perlu membaca semuanya sekaligus."
      />

      <div class="mt-10 grid gap-4 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <TaxCard tax={firstTax} featured class="h-full" />
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {otherTaxes.map((tax) => <TaxCard tax={tax} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Cara membaca -->
  <section class="border-y border-line bg-white/50 section-pad">
    <div class="container-page">
      <SectionHead
        eyebrow="Cara membaca"
        title="Empat pertanyaan sebelum menghitung."
        description="Urutan sederhana ini membantu Anda tidak mencampur objek, dasar pengenaan, dan kanal pembayaran."
      />
      <div class="mt-10 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        {
          [
            {
              step: "01",
              title: "Apa objeknya?",
              text: "Pastikan kegiatan atau barang yang Anda miliki memang termasuk objek pajak daerah yang dimaksud.",
              icon: "ph:crosshair",
            },
            {
              step: "02",
              title: "Siapa yang terutang?",
              text: "Tentukan pihak yang memiliki kewajiban: pemilik, pengusaha, pembeli, atau pemanfaat.",
              icon: "ph:user-circle",
            },
            {
              step: "03",
              title: "Apa dasarnya?",
              text: "Kenali dasar pengenaan seperti omzet, NJOP, NPOP, nilai sewa, atau volume pemakaian.",
              icon: "ph:ruler",
            },
            {
              step: "04",
              title: "Kapan dan di mana?",
              text: "Cek masa pajak, jatuh tempo, dan kanal pembayaran resmi yang berlaku.",
              icon: "ph:calendar-dots",
            },
          ].map((item) => (
            <div class="rounded-2xl border border-line bg-paper p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
                  <Icon name={item.icon} size={19} />
                </span>
                <span class="font-display text-xs font-semibold tabular-nums text-muted-soft">{item.step}</span>
              </div>
              <h3 class="mt-4 text-sm font-semibold text-ink">{item.title}</h3>
              <p class="mt-2 text-xs leading-6 text-muted">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bandingkan -->
  <section class="section-pad">
    <div class="container-page grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="eyebrow">
          <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
          Membedakan kewajiban
        </p>
        <h2 class="display-md mt-4">Pajak daerah atau pajak pusat?</h2>
        <p class="mt-5 text-[1.02rem] leading-8 text-muted">
          Keduanya bisa berlaku pada satu usaha. Yang membedakan adalah pihak yang memungut,
          dasar aturannya, dan ke mana pembayaran mengalir.
        </p>
        <a href="/edukasi/pbjt-dasar" class="link-arrow mt-6">
          Baca panduan dasarnya
          <Icon name="ph:arrow-right" size={14} />
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <article class="card p-6">
          <span class="badge badge-forest">Dikelola daerah</span>
          <h3 class="mt-4 font-display text-xl font-semibold text-ink">Pajak daerah</h3>
          <p class="mt-2 text-sm leading-7 text-muted">PBJT, PBB-P2, BPHTB, reklame, dan air tanah.</p>
          <ul class="mt-5 space-y-2.5 text-xs leading-6 text-muted">
            <li class="flex gap-2"><Icon name="ph:check" size={14} class="mt-1 shrink-0 text-forest-600" /> Dipungut pemerintah kabupaten</li>
            <li class="flex gap-2"><Icon name="ph:check" size={14} class="mt-1 shrink-0 text-forest-600" /> Diatur melalui Perda</li>
            <li class="flex gap-2"><Icon name="ph:check" size={14} class="mt-1 shrink-0 text-forest-600" /> Masuk kas daerah</li>
          </ul>
        </article>
        <article class="card p-6">
          <span class="badge bg-sand-100 text-honey-800">Dikelola pusat</span>
          <h3 class="mt-4 font-display text-xl font-semibold text-ink">Pajak pusat</h3>
          <p class="mt-2 text-sm leading-7 text-muted">PPh, PPN, dan jenis pajak lain yang dikelola pemerintah pusat.</p>
          <ul class="mt-5 space-y-2.5 text-xs leading-6 text-muted">
            <li class="flex gap-2"><Icon name="ph:check" size={14} class="mt-1 shrink-0 text-honey-600" /> Dipungut pemerintah pusat</li>
            <li class="flex gap-2"><Icon name="ph:check" size={14} class="mt-1 shrink-0 text-honey-600" /> Diatur melalui undang-undang nasional</li>
            <li class="flex gap-2"><Icon name="ph:check" size={14} class="mt-1 shrink-0 text-honey-600" /> Masuk kas negara</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Bantuan -->
  <section class="container-page pb-16">
    <div class="flex flex-col items-start justify-between gap-5 rounded-[1.5rem] border border-forest-200 bg-forest-50 p-6 sm:flex-row sm:items-center sm:p-7">
      <div class="flex items-start gap-4">
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-white text-forest-800">
          <Icon name="ph:circle-wavy-question" size={22} />
        </span>
        <div>
          <h2 class="font-display text-xl font-semibold text-forest-950">Tidak yakin usaha Anda masuk jenis yang mana?</h2>
          <p class="mt-1.5 text-sm leading-7 text-muted">Mulai dari deskripsi kegiatan. Petugas dapat membantu mencocokkan objek pajaknya.</p>
        </div>
      </div>
      <a href="/layanan/konsultasi" class="btn btn-primary shrink-0">
        Tanya petugas
        <Icon name="ph:arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-y border-line bg-white/50 section-pad">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
        <div>
          <p class="eyebrow">
            <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
            Pertanyaan umum
          </p>
          <h2 class="display-md mt-4">Sebelum menghitung sendiri.</h2>
          <p class="mt-5 text-sm leading-7 text-muted">
            Pahami perbedaan dasar dan batas informasi sebelum menggunakan hasil simulasi.
          </p>
        </div>
        <FaqList items={taxFaqs} />
      </div>
    </div>
  </section>

  <CtaPanel
    eyebrow="Langkah berikutnya"
    title="Coba hitung dengan angka Anda sendiri."
    description="Kalkulator simulasi membantu melihat pola perhitungan. Hasilnya tetap perlu dicocokkan dengan ketentuan dan kanal resmi."
    primaryLabel="Buka kalkulator"
    primaryHref="/kalkulator"
    secondaryLabel="Baca materi edukasi"
    secondaryHref="/edukasi"
  />
</BaseLayout>


