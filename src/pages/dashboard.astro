---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaPanel from "../components/CtaPanel.astro";
import DashboardPreview from "../components/DashboardPreview.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import { DASHBOARD_ROLES } from "../data/dashboards";

const site = Astro.site ?? new URL("https://pesona.example");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Contoh dashboard per peran PESONA",
  itemListElement: DASHBOARD_ROLES.map((role, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `Dashboard ${role.label}`,
    url: new URL(`/dashboard#${role.id}`, site).toString(),
  })),
};

const principles = [
  {
    title: "Data sesuai kebutuhan",
    text: "Warga melihat kewajiban dan permohonan. Petugas melihat antrean dan tindak lanjut. Setiap peran tidak perlu melihat seluruh data.",
    icon: "ph:eye",
  },
  {
    title: "Aksi punya jejak",
    text: "Setiap pengajuan, verifikasi, dan tanggapan dirancang memiliki status yang dapat ditelusuri oleh pihak yang berhak.",
    icon: "ph:clipboard-text",
  },
  {
    title: "Bukan akses penuh",
    text: "Tampilan berbeda bukan berarti akses tanpa batas. Hak akses, persetujuan, dan kewenangan tetap mengikuti peran.",
    icon: "ph:shield-check",
  },
  {
    title: "Selalu ada manusia",
    text: "Dashboard membantu menyiapkan dan memantau. Keputusan resmi tetap berada pada petugas dan pejabat berwenang.",
    icon: "ph:user-circle-check",
  },
];
---

<BaseLayout
  title="Contoh Dashboard per Peran"
  description="Ilustrasi ruang kerja PESONA untuk warga, pelaku usaha, petugas, dan koperasi: kewajiban, antrean layanan, realisasi, listing, dan bagi hasil."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Ruang kerja · Contoh dashboard"
    title="Satu platform,"
    highlight="empat ruang kerja."
    description="Setiap peran membutuhkan informasi yang berbeda. Lihat bagaimana PESONA merancang dashboard untuk warga, pelaku usaha, petugas, dan koperasi—tanpa membuka data yang tidak diperlukan."
    breadcrumbs={[
      { label: "Beranda", href: "/" },
      { label: "Contoh dashboard" },
    ]}
    icon="ph:squares-four"
  >
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href="#dashboard" class="btn btn-primary">
        Lihat contoh dashboard
        <Icon name="ph:arrow-down" size={17} />
      </a>
      <a href="/tentang#pengembangan" class="btn btn-secondary">
        Status pengembangan
        <Icon name="ph:lock-key" size={16} />
      </a>
    </div>

    <div slot="aside" class="card overflow-hidden bg-white/85">
      <div class="flex items-center justify-between gap-3 border-b border-line bg-forest-50/70 px-5 py-4">
        <div>
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.14em] text-forest-700">Empat peran</p>
          <p class="mt-1 font-display text-lg font-semibold text-ink">Satu data, beda fokus</p>
        </div>
        <Icon name="ph:users-three" size={22} class="text-forest-700" />
      </div>
      <div class="divide-y divide-line">
        {DASHBOARD_ROLES.map((role) => (
          <div class="flex items-center gap-3 px-5 py-3">
            <span class="inline-flex size-8 items-center justify-center rounded-lg bg-forest-50 text-forest-700">
              <Icon name={role.icon} size={15} />
            </span>
            <span class="flex-1 text-xs font-semibold text-ink">{role.label}</span>
            <span class="text-[0.58rem] font-medium text-muted-soft">contoh</span>
          </div>
        ))}
      </div>
      <p class="border-t border-line px-5 py-3 text-[0.62rem] leading-5 text-muted-soft">
        Tampilan ilustrasi. Belum ada akun atau data nyata.
      </p>
    </div>
  </PageHero>

  <!-- Dashboard -->
  <section id="dashboard" class="section-pad scroll-mt-24">
    <div class="container-page" data-dashboard-tabs>
      <SectionHead
        eyebrow="Pilih peran"
        title="Lihat prioritas dari sudut pandang mereka."
        description="Klik salah satu peran untuk mengganti tampilan. Setiap dashboard adalah ilustrasi arah pengembangan, bukan aplikasi yang sedang aktif."
      />

      <div class="mt-8 rounded-2xl border border-line bg-white/65 p-2.5">
        <div
          class="grid grid-cols-2 gap-1.5 sm:flex sm:flex-wrap"
          role="tablist"
          aria-label="Pilih peran dashboard"
        >
          {DASHBOARD_ROLES.map((role, index) => (
            <button
              id={`role-tab-${role.id}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`role-panel-${role.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-role-tab
              data-target={role.id}
              class:list={[
                "inline-flex items-center justify-center gap-2 rounded-xl border px-3.5 py-2.5 text-xs font-semibold transition sm:justify-start",
                index === 0
                  ? "border-forest-800 bg-forest-800 text-white shadow-sm"
                  : "border-line bg-white text-muted hover:border-forest-300 hover:text-forest-900",
              ]}
            >
              <Icon name={role.icon} size={15} />
              {role.label}
            </button>
          ))}
        </div>
      </div>

      <p class="mt-3 text-[0.68rem] text-muted-soft">
        <Icon name="ph:info" size={13} class="mr-1 inline-block align-[-2px]" />
        Pilihan peran mengubah contoh tampilan. Tidak ada data yang dimuat atau dikirim.
      </p>
      <p class="mt-1.5 text-[0.68rem] text-muted-soft">
        <Icon name="ph:cursor-click" size={13} class="mr-1 inline-block align-[-2px]" />
        Menu, kartu KPI, dan daftar tindakan di dalam dashboard bisa diklik untuk membuka halaman penjelasan terkait.
      </p>

      <div class="mt-6">
        {DASHBOARD_ROLES.map((role, index) => (
          <section
            id={`role-panel-${role.id}`}
            role="tabpanel"
            aria-labelledby={`role-tab-${role.id}`}
            data-role-panel={role.id}
            hidden={index !== 0}
            tabindex="0"
          >
            <DashboardPreview role={role} />

            <div class="mt-4 grid gap-4 rounded-[1.4rem] border border-line bg-white/70 p-5 lg:grid-cols-[1fr_auto] lg:items-center">
              <div>
                <p class="text-[0.62rem] font-bold uppercase tracking-[0.14em] text-forest-700">Yang terlihat</p>
                <div class="mt-2.5 flex flex-wrap gap-2">
                  {role.focus.map((item) => (
                    <span class="chip">
                      <Icon name="ph:check" size={12} class="text-forest-700" />
                      {item}
                    </span>
                  ))}
                </div>
                <p class="mt-3 text-xs leading-6 text-muted">{role.note}</p>
              </div>
              <a href={role.link.href} class="btn btn-secondary btn-sm shrink-0">
                {role.link.label}
                <Icon name="ph:arrow-right" size={14} />
              </a>
            </div>
          </section>
        ))}
      </div>

      <p class="fine-print mt-5">
        Seluruh angka, nama, dan status pada dashboard adalah ilustrasi. Halaman ini tidak
        menjalankan autentikasi, pengambilan data, atau aksi transaksional.
      </p>
    </div>
  </section>

  <!-- Prinsip -->
  <section class="border-y border-line bg-white/50 section-pad">
    <div class="container-page">
      <SectionHead
        eyebrow="Prinsip ruang kerja"
        title="Beda tampilan, tetap satu tata kelola."
        description="Dashboard yang baik tidak sekadar menampilkan angka. Ia membantu orang mengambil langkah berikutnya dengan aman."
      />
      <div class="mt-10 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {principles.map((principle) => (
          <div class="reveal rounded-2xl border border-line bg-paper p-5">
            <span class="inline-flex size-10 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
              <Icon name={principle.icon} size={19} />
            </span>
            <h3 class="mt-4 text-sm font-semibold text-ink">{principle.title}</h3>
            <p class="mt-2 text-xs leading-6 text-muted">{principle.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-5 rounded-2xl border border-[#D9E3F0] bg-[#F0F6FF] p-5 sm:p-6">
        <div class="flex items-start gap-3">
          <Icon name="ph:warning-circle" size={20} class="mt-0.5 shrink-0 text-forest-700" />
          <div>
            <p class="text-sm font-semibold text-ink">Yang tidak ditampilkan pada halaman ini.</p>
            <p class="mt-1.5 text-xs leading-6 text-muted">
              Data pribadi, formulir aktif, pembayaran, unggahan dokumen, dan akses ke sistem
              instansi tidak disertakan. Halaman ini hanya menunjukkan arah informasi yang akan
              terlihat di setiap peran.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaPanel
    eyebrow="Ruang kerja"
    title="Bangun pengalaman yang sesuai untuk tiap peran."
    description="Mulai dari pemahaman alur dan batas peran. Akun warga, pelaku usaha, petugas, dan koperasi akan dibuka bertahap setelah tahap konsep dan uji coba."
    primaryLabel="Lihat peta jalan"
    primaryHref="/tentang#pengembangan"
    secondaryLabel="Jelajahi layanan"
    secondaryHref="/layanan"
    note="Contoh dashboard · tidak ada data nyata yang ditampilkan atau diproses."
  />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-dashboard-tabs]");

  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-role-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-role-panel]"));
    const validIds = new Set(tabs.map((tab) => tab.dataset.target ?? ""));

    const selectRole = (id: string, focusTab = false, updateHash = true) => {
      if (!validIds.has(id)) return;

      tabs.forEach((tab) => {
        const selected = tab.dataset.target === id;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle("border-forest-800", selected);
        tab.classList.toggle("bg-forest-800", selected);
        tab.classList.toggle("text-white", selected);
        tab.classList.toggle("shadow-sm", selected);
        tab.classList.toggle("border-line", !selected);
        tab.classList.toggle("bg-white", !selected);
        tab.classList.toggle("text-muted", !selected);
        tab.classList.toggle("hover:border-forest-300", !selected);
        tab.classList.toggle("hover:text-forest-900", !selected);
        if (selected && focusTab) tab.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.rolePanel !== id;
      });

      if (updateHash) window.history.replaceState(null, "", `#${id}`);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectRole(tab.dataset.target ?? "warga"));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        selectRole(tabs[nextIndex].dataset.target ?? "warga", true);
      });
    });

    const hash = decodeURIComponent(window.location.hash.replace("#", ""));
    selectRole(validIds.has(hash) ? hash : "warga", false, false);

    if (validIds.has(hash)) {
      window.setTimeout(() => root.scrollIntoView({ behavior: "smooth", block: "start" }), 160);
    }

    window.addEventListener("hashchange", () => {
      const nextHash = decodeURIComponent(window.location.hash.replace("#", ""));
      if (validIds.has(nextHash)) selectRole(nextHash, false, false);
    });
  }
</script>
