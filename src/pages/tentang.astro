---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import { CITTAS, GOVERNANCE, PRINCIPLES, ROADMAP, SITE } from "../data/site";

const audiences = [
  {
    title: "Warga",
    description: "Memahami kewajiban pajak daerah dan menemukan kanal layanan yang tepat.",
    icon: "ph:user-circle",
  },
  {
    title: "Pelaku usaha",
    description: "Menyiapkan administrasi, melaporkan kewajiban, dan mengakses pendampingan.",
    icon: "ph:storefront",
  },
  {
    title: "Koperasi",
    description: "Mengelola anggota, listing, dan bagi hasil dengan catatan yang lebih terbuka.",
    icon: "ph:users-three",
  },
  {
    title: "Petugas",
    description: "Melayani, memantau antrean, dan menjaga konsistensi informasi publik.",
    icon: "ph:identification-badge",
  },
];

const changes = [
  { before: "Informasi tersebar di banyak kanal", after: "Satu alur yang bisa diikuti dari awal" },
  { before: "Istilah teknis tanpa penjelasan", after: "Bahasa manusia dan contoh nyata" },
  { before: "Data usaha diulang di setiap layanan", after: "Satu identitas yang digunakan kembali" },
  { before: "Status permohonan tidak jelas", after: "Kode referensi dan jejak status" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Tentang PESONA",
  description:
    "Tujuan, prinsip, batas peran, dan peta jalan konsep platform PESONA untuk Kabupaten Klungkung.",
  mainEntity: {
    "@type": "Organization",
    name: "PESONA",
    alternateName: "Pusat Edukasi & Optimalisasi Usaha",
    description: SITE.description,
    areaServed: { "@type": "AdministrativeArea", name: "Kabupaten Klungkung" },
  },
};
---

<BaseLayout
  title="Tentang PESONA"
  description="Tujuan, prinsip, batas peran, dan peta jalan PESONA — konsep platform edukasi, layanan, dan penguatan usaha untuk Kabupaten Klungkung."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Tentang PESONA"
    title="Merapikan jalan,"
    highlight="bukan menambah beban."
    description="PESONA adalah konsep kanal yang menyatukan edukasi pajak, layanan administrasi, dan penguatan usaha. Tujuannya bukan menambah aplikasi baru, tetapi membuat perjalanan yang sudah ada lebih mudah dipahami."
    breadcrumbs={[{ label: "Beranda", href: "/" }, { label: "Tentang" }]}
    icon="ph:compass"
  >
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href="#tujuan" class="btn btn-primary">
        Baca tujuan
        <Icon name="ph:arrow-down" size={17} />
      </a>
      <a href="#pengembangan" class="btn btn-secondary">
        Lihat status pengembangan
        <Icon name="ph:arrow-right" size={17} />
      </a>
    </div>

    <div slot="aside" class="card overflow-hidden bg-white/85">
      <div class="border-b border-line bg-forest-50/70 px-5 py-4">
        <div class="flex items-center justify-between gap-3">
          <span class="badge badge-sand">Tahap saat ini</span>
          <span class="inline-flex items-center gap-1.5 text-[0.62rem] font-semibold text-forest-700">
            <span class="size-1.5 rounded-full bg-honey-400"></span>
            Dalam pengembangan
          </span>
        </div>
        <p class="mt-3 font-display text-xl font-semibold text-ink">Konsep &amp; konten</p>
        <p class="mt-1 text-xs leading-6 text-muted">
          Narasi, peta layanan, materi edukasi, dan kalkulator simulasi disusun untuk diuji.
        </p>
      </div>
      <div class="px-5 py-4">
        <div class="flex items-center gap-1" aria-hidden="true">
          <span class="h-1.5 flex-1 rounded-full bg-honey-400"></span>
          <span class="h-1.5 flex-1 rounded-full bg-line"></span>
          <span class="h-1.5 flex-1 rounded-full bg-line"></span>
          <span class="h-1.5 flex-1 rounded-full bg-line"></span>
        </div>
        <p class="mt-2.5 text-[0.65rem] font-medium text-muted-soft">Tahap 1 dari 4</p>
        <a href="#pengembangan" class="link-arrow mt-4">
          Lihat peta jalan
          <Icon name="ph:arrow-right" size={14} />
        </a>
      </div>
    </div>
  </PageHero>

  <!-- Mengapa -->
  <section class="section-pad">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="eyebrow">
            <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
            Latar belakang
          </p>
          <h2 class="display-md mt-4">Masalahnya bukan kurang informasi. Informasinya tersebar.</h2>
          <p class="mt-5 text-[1.02rem] leading-8 text-muted">
            Warga dan pelaku usaha sering harus berpindah kanal, mengulang data, dan menebak
            langkah berikutnya. PESONA mencoba merapikan pengalaman itu tanpa mengambil alih
            kewenangan instansi.
          </p>
          <div class="mt-7 rounded-2xl border border-forest-200 bg-forest-50 p-5">
            <p class="flex items-center gap-2 text-sm font-semibold text-forest-900">
              <Icon name="ph:target" size={18} />
              Arah yang ingin dicapai
            </p>
            <p class="mt-2 text-xs leading-6 text-muted">
              Satu pintu pemahaman, satu identitas usaha, dan satu jejak layanan yang dapat
              dipantau oleh pemiliknya.
            </p>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {
            changes.map((change, index) => (
              <div class="card p-5">
                <div class="flex items-start justify-between gap-3">
                  <span class="font-display text-[0.7rem] font-bold uppercase tracking-[0.14em] text-muted-soft">
                    Perubahan {String(index + 1).padStart(2, "0")}
                  </span>
                  <Icon name="ph:arrows-left-right" size={16} class="text-forest-600" />
                </div>
                <p class="mt-4 text-xs leading-6 text-muted-soft line-through decoration-line-strong">
                  {change.before}
                </p>
                <div class="my-3 h-px bg-line"></div>
                <p class="text-sm font-semibold leading-6 text-forest-900">{change.after}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Tujuan -->
  <section id="tujuan" class="border-y border-line bg-white/50 section-pad scroll-mt-24">
    <div class="container-page">
      <SectionHead
        eyebrow="Tujuan"
        title="Tiga cita, satu pengalaman yang utuh."
        description="Setiap pilar punya peran, tetapi semuanya bekerja dalam satu alur yang saling terhubung."
      />

      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {
          CITTAS.map((citta) => (
            <a href={citta.href} class="group card card-hover flex h-full flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-forest-50 text-forest-800 transition group-hover:bg-forest-800 group-hover:text-white">
                  <Icon name={citta.icon} size={24} />
                </span>
                <span class="font-display text-sm font-semibold tabular-nums text-muted-soft">{citta.number}</span>
              </div>
              <p class="mt-6 text-[0.67rem] font-bold uppercase tracking-[0.13em] text-forest-700">{citta.meaning}</p>
              <h3 class="mt-2 font-display text-xl font-semibold text-ink">{citta.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-muted">{citta.description}</p>
              <span class="link-arrow mt-5">
                {citta.cta}
                <Icon name="ph:arrow-right" size={14} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Prinsip -->
  <section class="section-pad">
    <div class="container-page">
      <SectionHead
        eyebrow="Prinsip"
        title="Cara PESONA mengambil tempat."
        description="Prinsip ini menjadi pagar agar kanal tetap membantu, tidak menambah kekaburan baru."
      />
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          PRINCIPLES.map((principle) => (
            <div class="rounded-2xl border border-line bg-white/65 p-5">
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
                <Icon name={principle.icon} size={19} />
              </span>
              <h3 class="mt-4 text-sm font-semibold text-ink">{principle.title}</h3>
              <p class="mt-2 text-xs leading-6 text-muted">{principle.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Untuk siapa -->
  <section class="border-y border-line bg-sand-50/60 section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
      <div>
        <p class="eyebrow">
          <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
          Untuk siapa
        </p>
        <h2 class="display-md mt-4">Satu kanal, empat kebutuhan.</h2>
        <p class="mt-5 text-[1.02rem] leading-8 text-muted">
          PESONA tidak dirancang hanya untuk satu jenis pengguna. Peran yang berbeda perlu melihat
          informasi yang relevan tanpa harus memahami seluruh sistem.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          audiences.map((audience) => (
            <div class="flex gap-4 rounded-2xl border border-line bg-white/75 p-5">
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
                <Icon name={audience.icon} size={21} />
              </span>
              <div>
                <h3 class="text-sm font-semibold text-ink">{audience.title}</h3>
                <p class="mt-1.5 text-xs leading-6 text-muted">{audience.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Batas peran -->
  <section id="batas" class="section-pad scroll-mt-24">
    <div class="container-page">
      <SectionHead
        eyebrow="Batas & peran"
        title="Kanal pendamping, bukan pengambil alih kewenangan."
        description="Kejelasan batas membuat PESONA dapat dipercaya. Ini yang tidak dilakukan oleh PESONA."
      />
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          [
            {
              title: "Bukan situs resmi",
              text: "Situs ini adalah konsep independen. Informasi resmi tetap mengikuti kanal Pemerintah Kabupaten Klungkung.",
              icon: "ph:flag-banner",
            },
            {
              title: "Bukan penerbit izin",
              text: "Izin, sertifikat, dan rekomendasi tetap diterbitkan instansi berwenang sesuai ketentuan.",
              icon: "ph:seal-warning",
            },
            {
              title: "Bukan pemungut pembayaran",
              text: "Pembayaran pajak hanya melalui kanal resmi. PESONA tidak menerima pembayaran atau komisi per izin.",
              icon: "ph:prohibit",
            },
          ].map((item) => (
            <div class="rounded-2xl border border-[#D9E3F0] bg-[#F0F6FF] p-6">
              <span class="inline-flex size-11 items-center justify-center rounded-xl bg-white text-honey-700">
                <Icon name={item.icon} size={21} />
              </span>
              <h3 class="mt-4 text-sm font-semibold text-ink">{item.title}</h3>
              <p class="mt-2 text-xs leading-6 text-muted">{item.text}</p>
            </div>
          ))
        }
      </div>
      <p class="fine-print mt-6 max-w-3xl">
        Prototipe ini terpisah dari layanan resmi. Tidak ada autentikasi, pengiriman dokumen,
        pembayaran, email, atau WhatsApp nyata yang dijalankan dari situs ini.
      </p>
    </div>
  </section>

  <!-- Peta jalan -->
  <section id="pengembangan" class="surface-dark relative scroll-mt-24 overflow-hidden text-white">
    <div class="pointer-events-none absolute inset-0 opacity-[0.12] dot-grid-light" aria-hidden="true"></div>
    <div class="container-page section-pad relative">
      <div class="max-w-2xl">
        <p class="eyebrow-light">
          <span class="h-px w-7 bg-honey-300" aria-hidden="true"></span>
          Status pengembangan
        </p>
        <h2 class="display-md mt-4 text-white">Dibuka bertahap, bukan sekaligus.</h2>
        <p class="lead-light mt-5">
          Akun, verifikasi, integrasi data, dan pembayaran memerlukan tata kelola yang matang.
          PESONA bergerak melalui empat tahap yang dapat dievaluasi.
        </p>
      </div>

      <div class="mt-10 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        {
          ROADMAP.map((step) => (
            <div
              class:list={[
                "rounded-2xl border p-5",
                step.current
                  ? "border-honey-300/40 bg-honey-300/10"
                  : "border-white/10 bg-white/[0.045]",
              ]}
            >
              <div class="flex items-center justify-between gap-3">
                <span class:list={["font-display text-sm font-semibold tabular-nums", step.current ? "text-honey-200" : "text-forest-100/70"]}>
                  {step.step}
                </span>
                <span
                  class:list={[
                    "rounded-full px-2.5 py-1 text-[0.58rem] font-bold uppercase tracking-[0.08em]",
                    step.current ? "bg-honey-300 text-forest-950" : "bg-white/5 text-forest-100/70",
                  ]}
                >
                  {step.status}
                </span>
              </div>
              <h3 class="mt-4 text-sm font-semibold text-white">{step.title}</h3>
              <p class="mt-2 text-xs leading-6 text-forest-100/70">{step.description}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-col items-start justify-between gap-5 rounded-2xl border border-white/10 bg-white/[0.045] p-5 sm:flex-row sm:items-center">
        <div class="flex items-start gap-3">
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-white/10 text-honey-300">
            <Icon name="ph:lock-key" size={19} />
          </span>
          <div>
            <p class="text-sm font-semibold text-white">Fitur masuk belum tersedia.</p>
            <p class="mt-1 text-xs leading-6 text-forest-100/70">
              Tombol Masuk akan menampilkan pemberitahuan bahwa akun masih dalam pengembangan.
            </p>
          </div>
        </div>
        <a href="/tentang#pengembangan" data-login-open class="btn btn-accent shrink-0">
          Coba tombol Masuk
          <Icon name="ph:sign-in" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Tata kelola -->
  <section class="section-pad">
    <div class="container-page">
      <SectionHead
        eyebrow="Tata kelola"
        title="Data yang secukupnya, keputusan yang tetap manusiawi."
        description="Prinsip ini akan menjadi dasar saat PESONA masuk ke tahap uji coba dan integrasi."
      />
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          GOVERNANCE.map((item) => (
            <div class="rounded-2xl border border-line bg-white/65 p-5">
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
                <Icon name={item.icon} size={19} />
              </span>
              <h3 class="mt-4 text-sm font-semibold text-ink">{item.title}</h3>
              <p class="mt-2 text-xs leading-6 text-muted">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaPanel
    eyebrow="Mulai dari pemahaman"
    title="Kenali alurnya sebelum fiturnya dibuka."
    description="Baca layanan yang sedang dirancang, coba kalkulator simulasi, atau pelajari materi edukasi yang sudah tersedia."
    primaryLabel="Jelajahi layanan"
    primaryHref="/layanan"
    secondaryLabel="Buka pusat edukasi"
    secondaryHref="/edukasi"
    note="Situs konsep · bukan situs resmi · seluruh angka dan status adalah ilustrasi."
  />
</BaseLayout>
