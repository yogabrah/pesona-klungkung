---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import FaqList from "../../components/FaqList.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import { SERVICES, getService } from "../../data/services";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const relatedServices = service.related.map((slug) => getService(slug)).filter((item) => item !== undefined);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `Alur ${service.title} di PESONA`,
  description: service.description,
  inLanguage: "id-ID",
  step: service.steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.description,
  })),
};
---

<BaseLayout title={`${service.title} — Layanan`} description={service.description} jsonLd={jsonLd}>
  <PageHero
    eyebrow={service.kicker}
    title={service.title}
    highlight=""
    description={service.description}
    breadcrumbs={[
      { label: "Beranda", href: "/" },
      { label: "Layanan", href: "/layanan" },
      { label: service.shortTitle },
    ]}
    icon={service.icon}
  >
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href="/tentang#pengembangan" data-login-open class="btn btn-primary">
        Masuk untuk mulai
        <Icon name="ph:lock-key" size={16} />
      </a>
      <a href="/layanan" class="btn btn-secondary">
        Layanan lain
        <Icon name="ph:grid-four" size={16} />
      </a>
    </div>

    <div slot="aside" class="card overflow-hidden bg-white/85">
      <div class="bg-forest-900 px-5 py-5 text-white">
        <div class="flex items-center justify-between gap-3">
          <span class="badge-dark">Status layanan</span>
          <span class="inline-flex items-center gap-1.5 text-[0.62rem] font-semibold text-honey-200">
            <span class="size-1.5 rounded-full bg-honey-300"></span>
            Dalam pengembangan
          </span>
        </div>
        <p class="mt-3 font-display text-xl font-semibold text-white">{service.tag}</p>
        <p class="mt-1 text-[0.68rem] leading-5 text-forest-100/65">{service.meta}</p>
      </div>
      <div class="px-5 py-3">
        <div class="flex items-center justify-between gap-3 py-2 text-xs">
          <span class="text-muted-soft">Jumlah langkah</span>
          <span class="font-semibold text-ink">{service.steps.length} tahap</span>
        </div>
        <div class="flex items-center justify-between gap-3 border-t border-line py-2 text-xs">
          <span class="text-muted-soft">Pendampingan</span>
          <span class="font-semibold text-ink">Dijelaskan</span>
        </div>
        <div class="flex items-center justify-between gap-3 border-t border-line py-2 text-xs">
          <span class="text-muted-soft">Pengajuan nyata</span>
          <span class="font-semibold text-ink">Belum tersedia</span>
        </div>
      </div>
      <div class="border-t border-line p-4">
        <a href="/tentang#pengembangan" data-login-open class="btn btn-primary btn-sm w-full">
          Coba tombol Masuk
          <Icon name="ph:sign-in" size={15} />
        </a>
        <p class="mt-2.5 text-center text-[0.62rem] leading-5 text-muted-soft">
          Akun dan formulir masih dalam pengembangan.
        </p>
      </div>
    </div>
  </PageHero>

  <!-- Ringkasan -->
  <section class="section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <div>
        <p class="eyebrow">
          <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
          Tentang layanan ini
        </p>
        <h2 class="display-md mt-4">Apa yang akan Anda temui.</h2>
        <div class="mt-6 space-y-5 text-[1.02rem] leading-8 text-muted">
          {service.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="rounded-[1.5rem] border border-line bg-white/70 p-6">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex size-10 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
            <Icon name="ph:users-three" size={20} />
          </span>
          <h2 class="font-display text-lg font-semibold text-ink">Untuk siapa?</h2>
        </div>
        <ul class="mt-5 space-y-3">
          {service.audience.map((audience) => (
            <li class="flex gap-2.5 text-sm leading-6 text-muted">
              <Icon name="ph:check-circle" size={16} class="mt-1 shrink-0 text-forest-600" />
              {audience}
            </li>
          ))}
        </ul>
        <div class="mt-5 rounded-xl border border-line bg-paper p-4">
          <p class="flex items-start gap-2 text-[0.68rem] leading-5 text-muted-soft">
            <Icon name="ph:info" size={14} class="mt-0.5 shrink-0 text-forest-700" />
            Penjelasan ini adalah bagian dari konsep. Tidak ada permohonan atau data yang dikirim
            dari halaman ini.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Alur -->
  <section class="border-y border-line bg-white/50 section-pad">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">
          <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
          Alur layanan
        </p>
        <h2 class="display-md mt-4">Langkah yang akan dilalui.</h2>
        <p class="mt-4 text-[1.02rem] leading-8 text-muted">
          Setiap tahap menjelaskan apa yang terjadi dan apa yang perlu Anda siapkan.
        </p>
      </div>

      <div class="mt-10 grid gap-3 md:grid-cols-2">
        {
          service.steps.map((step, index) => (
            <div class="relative rounded-2xl border border-line bg-paper p-6">
              <div class="flex items-start justify-between gap-3">
                <span class="inline-flex size-11 items-center justify-center rounded-2xl bg-forest-50 text-forest-800">
                  <Icon name={step.icon} size={21} />
                </span>
                <span class="font-display text-2xl font-semibold leading-none text-muted-soft">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <h3 class="mt-4 font-display text-lg font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 text-sm leading-7 text-muted">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Persiapan & hasil -->
  <section class="section-pad">
    <div class="container-page grid gap-5 lg:grid-cols-2">
      <div class="card p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex size-10 items-center justify-center rounded-xl bg-sand-100 text-honey-800">
              <Icon name="ph:folder-open" size={20} />
            </span>
            <h2 class="font-display text-lg font-semibold text-ink">Yang perlu disiapkan</h2>
          </div>
          <span class="badge bg-sand-100 text-honey-800">Daftar awal</span>
        </div>
        <ul class="mt-5 divide-y divide-line">
          {service.prepared.map((item, index) => (
            <li class="flex gap-3 py-3.5">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-forest-50 text-[0.62rem] font-bold tabular-nums text-forest-700">
                {index + 1}
              </span>
              <div>
                <p class="text-sm font-semibold text-ink">{item.title}</p>
                {item.description && <p class="mt-1 text-xs leading-6 text-muted">{item.description}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="card p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex size-10 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
              <Icon name="ph:flag-checkered" size={20} />
            </span>
            <h2 class="font-display text-lg font-semibold text-ink">Hasil yang diharapkan</h2>
          </div>
          <span class="badge badge-forest">Manfaat</span>
        </div>
        <div class="mt-5 space-y-3">
          {
            service.outcomes.map((outcome) => (
              <div class="flex gap-3 rounded-xl border border-line bg-paper/70 p-4">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-forest-50 text-forest-700">
                  <Icon name={outcome.icon} size={16} />
                </span>
                <div>
                  <p class="text-xs font-semibold text-ink">{outcome.title}</p>
                  <p class="mt-1 text-[0.68rem] leading-5 text-muted">{outcome.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="container-page mt-5">
      <div class="rounded-[1.4rem] border border-[#D9E3F0] bg-[#F0F6FF] p-5 sm:p-6">
        <div class="flex items-start gap-3">
          <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-white text-honey-700">
            <Icon name="ph:warning-circle" size={18} />
          </span>
          <div>
            <h2 class="text-sm font-semibold text-ink">Catatan sebelum Anda mengandalkan layanan ini.</h2>
            <ul class="mt-2 space-y-1.5 text-xs leading-6 text-muted">
              {service.notes.map((note) => <li class="flex gap-2"><span class="mt-2 size-1 shrink-0 rounded-full bg-honey-500"></span>{note}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-y border-line bg-white/50 section-pad">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
        <div>
          <p class="eyebrow">
            <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
            Pertanyaan layanan
          </p>
          <h2 class="display-md mt-4">Hal yang sering ditanyakan.</h2>
          <p class="mt-5 text-sm leading-7 text-muted">
            Jika pertanyaan Anda belum terjawab, pelajari alur konsultasi atau hubungi kanal resmi
            saat layanan dibuka.
          </p>
          <a href="/layanan/konsultasi" class="link-arrow mt-6">
            Buka konsultasi
            <Icon name="ph:arrow-right" size={14} />
          </a>
        </div>
        <FaqList items={service.faqs} />
      </div>
    </div>
  </section>

  <!-- Layanan lain -->
  <section class="section-pad">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">
            <span class="h-px w-7 bg-honey-400" aria-hidden="true"></span>
            Layanan lain
          </p>
          <h2 class="display-md mt-3">Lanjutkan ke langkah berikutnya.</h2>
        </div>
        <a href="/layanan" class="link-arrow">Lihat semua layanan <Icon name="ph:arrow-right" size={14} /></a>
      </div>
      <div class="mt-8 grid gap-3 md:grid-cols-3">
        {
          relatedServices.map((related) => (
            <a href={`/layanan/${related.slug}`} class="group card card-hover flex items-center gap-4 p-5">
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-forest-50 text-forest-800">
                <Icon name={related.icon} size={21} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-ink group-hover:text-forest-800">{related.title}</p>
                <p class="mt-0.5 text-[0.65rem] text-muted">{related.meta.split(" · ")[0]}</p>
              </div>
              <Icon name="ph:arrow-up-right" size={15} class="shrink-0 text-muted-soft" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaPanel
    eyebrow="Masih dalam pengembangan"
    title="Kenali alurnya, lalu tunggu fiturnya dibuka."
    description="Akun dan formulir layanan belum tersedia. Anda tetap dapat mempelajari dokumen, alur, dan batasannya, atau melihat status peta jalan."
    primaryLabel="Masuk ke PESONA"
    primaryLogin
    secondaryLabel="Kembali ke layanan"
    secondaryHref="/layanan"
    note="Tombol Masuk akan menampilkan pemberitahuan pengembangan. Tidak ada data yang dikirim."
  />
</BaseLayout>
